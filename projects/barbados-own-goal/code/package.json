{
  "name": "animated-shorts-kit",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Preview out/still.png --frame=60",
    "preview": "remotion render src/index.ts Preview out/preview.mp4",
    "gates": "tsx --tsconfig src/videos/01_example/tsconfig.json src/engine/check/gates.ts",
    "gates:barbados": "tsx --tsconfig src/videos/02_barbados_own_goal/tsconfig.json src/engine/check/gates.ts",
    "preview:barbados": "VIDEO=02_barbados_own_goal remotion render src/index.ts Preview out/02_barbados_own_goal_v1_preview.mp4",
    "full:barbados": "VIDEO=02_barbados_own_goal remotion render src/index.ts Video out/02_barbados_own_goal_v1_full.mp4",
    "studio:barbados": "VIDEO=02_barbados_own_goal remotion studio src/index.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@remotion/cli": "^4.0.545",
    "@remotion/three": "^4.0.545",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.545",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/react": "^18.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}